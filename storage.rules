rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User-specific assets: posters and character anchors
    // Expected path format: users/{userId}/{projectId}/...
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy support: if you haven't migrated to users/ path yet, 
    // we should at least restrict read/write to the backend service account for global paths.
    match /{allPaths=**} {
      allow read: if request.auth != null; // Temporarily keep readable for UI
      allow write: if false; // Deny direct upload, go through backend
    }
  }
}
