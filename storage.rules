rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public assets like posters and characters should be readable by anyone
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Allow authenticated users to upload
    }
    
    match /character_anchors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Allow authenticated users to upload
    }
    
    // Teasers, which might be sensitive, remain public read but not publicly writable
    match /teasers/{allPaths=**} {
        allow read: if true;
        allow write: if false; // Backend only
    }

    // Fallback for any other paths - Read Only for authenticated users
    match /{allOtherPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
