rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read their own profile.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only backend can write credits/plan.
    }
    
    // Rules for top-level universe documents.
    match /universes/{universeId} {
      allow read, write: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      
      // Nested projects within a universe
      match /projects/{projectId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/universes/$(universeId)).data.owner_id == request.auth.uid;
        
        // Subcollections of projects
        match /{allSubcollections=**} {
          allow read, write: if request.auth != null && get(/databases/$(database)/documents/universes/$(universeId)).data.owner_id == request.auth.uid;
        }
      }
    }

    // **COLLECTION GROUP RULE** for 'projects'
    // This allows listing projects across universes for the Dashboard.
    match /{path=**}/projects/{projectId} {
      allow read: if request.auth != null && (resource == null || resource.data.owner_id == request.auth.uid);
      allow write: if request.auth != null && (resource == null || resource.data.owner_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
    }
    
    // Rules for Pitch Sharing and Tracking
    match /share_links/{shareId} {
      // Only the owner can manage links or see analytics
      allow read, write: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      
      // Events sub-collection (Analytics)
      match /events/{eventId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/share_links/$(shareId)).data.owner_id == request.auth.uid;
        allow write: if false; // Only backend (Admin SDK) should write events
      }
    }

    // Deny access to backend-only collections.
    match /leads/{leadId} {
      allow read, write: if false;
    }
    match /mail_queue/{mailId} {
      allow read, write: if false;
    }
    
    // Rules for public analysis tool.
    match /temporary_analyses/{analysisId} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
    }
  }
}
